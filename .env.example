# 已实现：fake（无需 Key）| internal（OpenAI 兼容协议）
LLM_PROVIDER=fake
# LLM_PROVIDER=internal 时配置；请勿提交真实密钥
# LLM_BASE_URL=http://localhost:9000/v1
# LLM_MODEL=local-model
# LLM_API_KEY=
# 新增CLI对话封装：MODEL_NAME优先；留空沿用旧LLM_MODEL，均为空时默认gpt-4o-mini。
# 默认 LLM_PROVIDER=fake 用于离线演示；CLI --real 仅切换该进程的对话模型。
# LLM_MODEL_NAME=gpt-4o-mini
# LLM_TIMEOUT=75
# LLM_MAX_CONCURRENCY=1
# LLM_MAX_TOKENS=512
# LLM_CHAT_TEMPERATURE=0.2
# LLM_CHAT_MAX_HISTORY_CHARS=24000
# 公网IP/域名端点须先获准并开放网络策略；默认只允许localhost/私有IP，不做DNS猜测。
# LLM_ALLOW_EXTERNAL=false
# 可选：每1000 token的美元单价，必须成对提供；未配置时报告明确显示成本未知。
# LLM_INPUT_COST_PER_1K=0.001
# LLM_OUTPUT_COST_PER_1K=0.002

# Python 数据库支持本地 sqlite 和单独运行的 PostgreSQL 16。
DB_DRIVER=sqlite
# SQLITE_PATH=.data/python/interviews.sqlite3
# 已有离线快照可按 README 导入空库。

# DB_DRIVER=postgres 时必填
# DATABASE_URL=
# 生产 DATABASE_URL 必须使用 NOSUPERUSER NOBYPASSRLS 角色（Task 4）；compose 开发可用超级用户迁移，上线前切到 aii_app。
# 本地 compose 示例（勿提交真实密码）：
# DATABASE_URL=postgresql+psycopg://aii_app:CHANGE_ME@127.0.0.1:5432/aii

# Task 8a 运维：Celery + Redis（报告异步任务 / 保留期清理）
# REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_TASK_ALWAYS_EAGER=false
# 定时清理默认 dry-run；显式 true 才执行删除
# CELERY_CLEANUP_EXECUTE=false
# HTTP /score 默认仍同步；异步路径见 Celery task generate_report_task（D78）

# 数据治理
# 保留期默认 90 天，管理员可以通过 API 保存 1–90 天策略。
# 设置 ADMIN_API_KEY 后可运行 python -m interviewer.cli retention-preview。

# 应用
APP_BASE_URL=http://127.0.0.1:8000
# 网页联调时，APP_BASE_URL 填浏览器实际访问的 origin。鉴权校验协议、端口和主机名，回环主机名可互换。
# 以下为 Node 启动进程的环境变量，可在终端设置。
# PYTHON_API_URL=  # Next 服务端转发目标，浏览器始终通过同源 /api/* 访问。
# NEXT_DIST_DIR=
# API_HOST=
# API_PORT=
# PYTHON_EXECUTABLE=

# 联合启动默认使用账号密码。仅本地合成演示在终端显式设置 DEMO_MODE=true 和 LLM_PROVIDER=fake。
# 联合启动生成的初始账号保存在 .data/workspace-accounts.json；部署注入可在终端设置以下账号变量。
# DEMO_MODE=false
# AUTH_SECRET=  # 至少 32 字符，部署时从密钥管理器注入
# RECRUITER_USERNAME=recruiter
# RECRUITER_PASSWORD=  # 招聘者网页密码
# RECRUITER_API_KEY=  # 可选：仅服务端/API 调用使用，勿放入客户端
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=  # 管理员网页密码
# ADMIN_API_KEY=  # 仅管理员API/部署清理任务使用，勿与招聘者密钥共用

# 可选：企业/内网 OpenAI-compatible 音频转写服务；未配置时仅尝试设备端识别。
# 只接收每段 ≤120秒的16kHz单声道PCM WAV，音频不落盘、不保存视频。
# STT_BASE_URL=http://localhost:9000/v1
# STT_MODEL=whisper-1
# STT_API_KEY=
# STT_PROCESSOR_LABEL=企业内网转写服务

# 可选：使用已有 Python Whisper 环境和本地权重，启动时加载一次；不会下载模型。
# STT_PROVIDER=whisper
# STT_MODEL=base
# STT_MODEL_PATH=.data/models/whisper/base.pt  # 相对路径以仓库根为准，也接受绝对路径
# STT_MODEL_SHA256=  # 可选：权重文件 SHA-256，小写十六进制
# STT_DEVICE=cpu
# STT_LANGUAGE=zh
# STT_INITIAL_PROMPT="以下是普通话技术面试回答，请使用简体中文和简体标点。"  # 可选，默认空
# STT_TIMEOUT=60
# STT_MAX_CONCURRENCY=1
# STT_PROCESSOR_LABEL=本机Whisper转写（音频仅内存处理）
# 不启用 Whisper 时，STT_PROVIDER=auto 保留原来的内网 HTTP / 设备端识别选择。
# 可选文件转写封装：相对路径以仓库根为准，也接受绝对路径；留空时使用当前进程 PATH。
# FFMPEG_PATH=.data/tools/ffmpeg.exe

# Edge TTS是微软在线服务，需要外网。默认local保持设备本地播报，不调用Edge。
# tts_service.generate_speech的独立开关，默认关闭；false直接返回None，纯文本输出。
ENABLE_EDGE_TTS=false
# 开启需先批准微软Edge语音域名的出站HTTPS/WSS白名单；开关本身不代表网络策略已配置。
# 仅在负责人明确允许外网例外后启用；只发送固定题目，不发送候选人回答/简历。
# TTS_PROVIDER=edge
# TTS_ALLOW_EXTERNAL=false
# TTS_VOICE=zh-CN-XiaoxiaoNeural
# TTS_RATE=-5%
# TTS_TIMEOUT=30
# TTS_CONNECT_TIMEOUT=10
# TTS_MAX_CONCURRENCY=2

# 可选：只输出固定操作名/随机请求ID/状态码/耗时；不输出URL、正文或身份。
# 未设置时仍可由独立管理员通过 /api/admin/operations 读取本进程累计指标。
# OBSERVABILITY_LOGS=true

# 飞书应用（发布后填写；唯一配置源为 Python Settings / 运行时接口，勿提交真实密钥）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# 境内默认 open.feishu.cn；国际区改为 https://open.larksuite.com
FEISHU_API_BASE_URL=https://open.feishu.cn
# OAuth 回调示例：https://你的域名/login/feishu（须与飞书控制台登记一致）
FEISHU_OAUTH_REDIRECT_URI=
# 可选 OAuth scope，空则不带 scope 参数
FEISHU_SCOPES=
# 逗号分隔 open_id 白名单；命中后签发对应工作台会话 cookie
FEISHU_RECRUITER_OPEN_IDS=
FEISHU_ADMIN_OPEN_IDS=
# 可选：机器人 Webhook（仅服务端；通知只允许场次 ID/状态/链接）
FEISHU_BOT_WEBHOOK=

